{
  "workspace": {
    "name": "MDM Shopify Workspace",
    "root": "~/MDM/",
    "updated": "1. September 2026",
    "repos": [
      {
        "id": "theme",
        "name": "Shopify Theme",
        "path": "theme/",
        "tech": "Liquid / CSS / JS (Hyper 1.3.3 by FoxEcom)",
        "git": "Shopify-eigenes Git",
        "store": "mdm-muenze",
        "status": "aktiv"
      },
      {
        "id": "connector",
        "name": "Shopify Connector",
        "path": "connector/",
        "tech": "Rails 8.1 / React 18 / Polaris / Sidekiq / PostgreSQL",
        "git": "github.com-borek:borekDigital/shopifyConnector",
        "deploy": "Docker → registry.mdm.de → GitLab",
        "status": "aktiv"
      },
      {
        "id": "datalayer",
        "name": "GTM Datalayer",
        "path": "datalayer/",
        "tech": "JavaScript (geplant)",
        "git": "github.com-borek:borekDigital/shopifyDatalayer",
        "status": "aktiv"
      }
    ]
  },
  "agents": [
    {
      "id": "figma-extractor",
      "name": "Figma Extractor",
      "scope": "theme",
      "model": "sonnet",
      "role": "Extrahiert Design-Specs, Tokens und Assets aus Figma",
      "writes": ["Tickets/"],
      "reads": ["Figma MCP"],
      "trigger": "Figma-URL oder node-id als Quelle fuer Theme-Arbeit",
      "phase": "Extraktion",
      "maxTurns": 30
    },
    {
      "id": "theme-planner",
      "name": "Theme Planner",
      "scope": "theme",
      "model": "opus",
      "role": "Mappt Design-Spec auf Hyper-Architektur, erstellt Plan-Artefakt. Zwei Modi: Block Map (ganze Seite) und Block Plan (einzelner Block)",
      "writes": ["Tickets/plans/"],
      "reads": ["theme/sections/", "theme/snippets/", "theme/blocks/", "theme/templates/"],
      "trigger": "Design-Spec bereit oder neues Theme-Feature angefragt",
      "phase": "Planung",
      "maxTurns": 40
    },
    {
      "id": "liquid-implementer",
      "name": "Liquid Implementer",
      "scope": "theme",
      "model": "inherit (opus)",
      "role": "Setzt freigegebene Block-Plaene in Liquid/CSS/JS um",
      "writes": ["theme/"],
      "reads": ["Tickets/plans/", "theme/"],
      "trigger": "Block-Plan von Konrad freigegeben",
      "phase": "Implementierung",
      "maxTurns": 50
    },
    {
      "id": "theme-reviewer",
      "name": "Theme Reviewer",
      "scope": "theme",
      "model": "sonnet",
      "role": "QA: Konventionen, a11y, Performance, Visual Parity",
      "writes": [],
      "reads": ["theme/", "Tickets/"],
      "trigger": "Nach jeder Implementierungsphase (parallel mit security-reviewer)",
      "phase": "Review",
      "maxTurns": 30,
      "readOnly": true
    },
    {
      "id": "rails-planner",
      "name": "Rails Planner",
      "scope": "connector",
      "model": "opus",
      "role": "Mappt Features auf Rails-Architektur, erstellt Plan-Artefakt MIT Spec-Skeletons (ausfuehrbare RSpec-Dateien mit pending). Specs sind die primaere Spezifikation",
      "writes": ["Tickets/plans/", "connector/spec/ (Skeletons)"],
      "reads": ["connector/app/", "connector/config/", "connector/extensions/", "connector/docs/"],
      "trigger": "Neues Connector-Feature oder Bug",
      "phase": "Planung",
      "maxTurns": 40
    },
    {
      "id": "rails-implementer",
      "name": "Rails Implementer",
      "scope": "connector",
      "model": "inherit (opus)",
      "role": "Setzt freigegebene Plan-Phasen via striktem TDD um (Red → Green → Refactor). Arbeitet mit eingefrorenen Spec-Skeletons aus der Plan-Phase",
      "writes": ["connector/"],
      "reads": ["Tickets/plans/", "connector/"],
      "trigger": "Plan + Spec-Skeletons von Konrad freigegeben",
      "phase": "Implementierung",
      "maxTurns": 50
    },
    {
      "id": "rails-reviewer",
      "name": "Rails Reviewer",
      "scope": "connector",
      "model": "sonnet",
      "role": "QA: RuboCop, Queries, GraphQL, Migrations, Extensions. Prueft Skeleton-Treue, Test-Coverage und Factory-Qualitaet",
      "writes": [],
      "reads": ["connector/"],
      "trigger": "Nach jeder Implementierungsphase (parallel mit security-reviewer)",
      "phase": "Review",
      "maxTurns": 30,
      "readOnly": true
    },
    {
      "id": "security-reviewer",
      "name": "Security Reviewer",
      "scope": "uebergreifend",
      "model": "sonnet",
      "role": "Security: XSS, DSGVO, Secrets, Auth, SQL Injection, CORS. Prueft keine Secrets in Fixtures/Factories, VCR-Cassettes gefiltert",
      "writes": [],
      "reads": ["theme/", "connector/"],
      "trigger": "Nach jeder Implementierungsphase (parallel mit theme-/rails-reviewer)",
      "phase": "Review",
      "maxTurns": 30,
      "readOnly": true
    },
    {
      "id": "docs-writer",
      "name": "Docs Writer",
      "scope": "uebergreifend",
      "model": "haiku",
      "role": "Deutsche Projekt-Doku und Completion-Artefakte",
      "writes": ["theme/docs/", "connector/docs/", "Tickets/"],
      "reads": ["theme/", "connector/", "Tickets/"],
      "trigger": "Alle Reviews APPROVED",
      "phase": "Dokumentation",
      "maxTurns": 20
    }
  ],
  "skills": [
    {
      "id": "mdm-template",
      "name": "/mdm-template",
      "scope": "theme",
      "description": "Page-Level-Orchestrator: Figma-Seite in Block Map zerlegen, dann jeden Block via /mdm-block umsetzen",
      "trigger": "Neue Seite aus Figma, mehrere Sections auf einmal planen",
      "phases": ["Setup", "Extraktion", "Block Map", "Freigabe", "Block-PRs via /mdm-block", "Template-JSON", "Doku"],
      "files": ["SKILL.md", "figma-mapping.md", "qa-checklist.md", "security-checklist.md"]
    },
    {
      "id": "mdm-block",
      "name": "/mdm-block",
      "scope": "theme",
      "description": "Per-Block-Workflow: ein Block = ein Branch = ein PR. Theme-First — bestehende Hyper-Sections ueberschreiben, nicht neu bauen",
      "trigger": "Einzelne Section anpassen (Breadcrumbs, Multicolumn, Collapsible-Tabs, etc.)",
      "phases": ["Kontext", "Block-Plan", "Freigabe", "Implementierung", "Review", "Uebergabe"],
      "files": ["SKILL.md"]
    },
    {
      "id": "figma-to-liquid",
      "name": "/figma-to-liquid",
      "scope": "theme",
      "description": "Extraktions- und Mapping-Konventionen Figma zu Liquid",
      "trigger": "Figma-Extraktion oder Design-Token-Mapping",
      "files": ["SKILL.md"]
    },
    {
      "id": "connector-feature",
      "name": "/connector-feature",
      "scope": "connector",
      "description": "End-to-End-Workflow: Git Worktree + Spec-Skeletons + TDD (Red → Green → Refactor) + Plan-Gate + parallele Reviews",
      "trigger": "Neues Backend-Feature, Extension, API-Erweiterung, Bugfix",
      "phases": ["Setup (Worktree)", "Planung + Spec-Skeletons", "Freigabe", "TDD-Implementierung", "Review", "Doku", "Uebergabe + Cleanup"],
      "files": ["SKILL.md"]
    },
    {
      "id": "mdm-notes",
      "name": "/mdm-notes",
      "scope": "uebergreifend",
      "description": "Apple-Notes-Pflege (Tagebuch, Tickets, System-Notizen)",
      "trigger": "Session-Start/-Ende, Ticket-Meilensteine, Tagebuch-Eintraege",
      "files": ["SKILL.md"]
    }
  ],
  "rules": [
    {
      "id": "liquid-conventions",
      "name": "Liquid-Konventionen",
      "scope": "theme/sections, snippets, blocks, layout",
      "key_rules": ["mdm-Praefix", "FoxEcom unangetastet", "escape-Pflicht", "i18n paarig", "keine externen Ressourcen"]
    },
    {
      "id": "templates-json",
      "name": "JSON-Templates",
      "scope": "theme/templates",
      "key_rules": ["Reines JSON", "Sprechende Section-IDs", "JSON-Parse-Test"]
    },
    {
      "id": "merchant-config",
      "name": "Merchant-Config",
      "scope": "theme/config, locales",
      "key_rules": ["settings_data.json unangetastet", "Locales paarig", "Schema additiv"]
    },
    {
      "id": "connector-conventions",
      "name": "Connector-Konventionen",
      "scope": "connector/app, config, db, lib",
      "key_rules": ["RuboCop Shopify-Preset", "Job-Namespaces", "GraphQL-Schema-Trennung", "Secrets nur ENV", "TDD-Pflicht (Red → Green → Refactor)", "WebMock/VCR fuer externe APIs"]
    }
  ],
  "hooks": [
    {
      "id": "git-safety",
      "name": "Git Safety",
      "event": "PreToolUse (Bash)",
      "blocks": ["force-push", "push main/master", "reset --hard", "clean -f", "theme publish/delete", "push --live", "--theme-editor-sync"]
    },
    {
      "id": "protect-merchant-files",
      "name": "Merchant File Protection",
      "event": "PreToolUse (Edit|Write)",
      "blocks": ["settings_data.json (hart)", "FoxEcom-Kerndateien (Rueckfrage)", "Neue Dateien ohne mdm-Praefix (Rueckfrage)"]
    },
    {
      "id": "post-edit-theme-check",
      "name": "Post-Edit Theme Check",
      "event": "PostToolUse (Edit|Write)",
      "action": "shopify theme check gefiltert auf editierte Datei (nur theme/)"
    },
    {
      "id": "post-edit-rubocop",
      "name": "Post-Edit RuboCop",
      "event": "PostToolUse (Edit|Write)",
      "action": "RuboCop gefiltert auf editierte Datei (nur connector/*.rb)"
    },
    {
      "id": "stop-notify",
      "name": "Stop Notification",
      "event": "Stop",
      "action": "macOS-Benachrichtigung"
    },
    {
      "id": "post-implement-harness-sync",
      "name": "Harness-Sync Check",
      "event": "Stop",
      "action": "Prueft ob neue Agenten/Skills/Hooks/Rules in der README dokumentiert sind"
    }
  ],
  "workflows": {
    "theme": {
      "name": "Theme-Workflow (Block-per-PR)",
      "steps": [
        {"phase": 0, "name": "Setup", "agent": null, "description": "Ticket-Ordner, Branch, Commit-Check"},
        {"phase": 1, "name": "Extraktion", "agent": "figma-extractor", "description": "design-spec.md, Screenshot, Assets aus Figma"},
        {"phase": 2, "name": "Block Map / Block Plan", "agent": "theme-planner", "description": "Block Map (ganze Seite) oder Block Plan (einzelne Section)"},
        {"phase": "gate", "name": "Freigabe", "agent": null, "description": "MANDATORY STOP — Konrad prueft und gibt frei"},
        {"phase": 3, "name": "Implementierung", "agent": "liquid-implementer", "description": "Liquid/CSS/JS nach freigegebenem Block-Plan"},
        {"phase": "review", "name": "Review", "agent": "theme-reviewer + security-reviewer", "description": "Parallel, max 3 Revision-Loops"},
        {"phase": 4, "name": "Uebergabe", "agent": null, "description": "Commit-Message als Text, Konrad committet (1 Block = 1 PR)"}
      ]
    },
    "connector": {
      "name": "Connector-Workflow (TDD + Git Worktree)",
      "steps": [
        {"phase": 0, "name": "Setup", "agent": null, "description": "Worktree anlegen (connector-worktrees/), .env kopieren"},
        {"phase": 1, "name": "Planung + Specs", "agent": "rails-planner", "description": "Plan-Artefakt MIT Spec-Skeletons (pending). Specs = Spezifikation"},
        {"phase": "gate", "name": "Freigabe", "agent": null, "description": "MANDATORY STOP — Konrad prueft Plan + Spec-Skeletons gemeinsam"},
        {"phase": 2, "name": "TDD-Implementierung", "agent": "rails-implementer", "description": "Pro Phase: Red (Specs aktivieren) → Green (minimaler Code) → Refactor"},
        {"phase": "review", "name": "Review", "agent": "rails-reviewer + security-reviewer", "description": "Parallel, Skeleton-Treue pruefen, max 3 Revision-Loops"},
        {"phase": 3, "name": "Dokumentation", "agent": "docs-writer", "description": "connector/docs/ + Completion-Artefakt"},
        {"phase": 4, "name": "Uebergabe + Cleanup", "agent": null, "description": "Commit-Message als Text, Worktree entfernen, Branch loeschen"}
      ]
    }
  },
  "architecture": {
    "dataFlows": [
      {"from": "Figma", "to": "theme", "label": "Design-Specs, Tokens, Assets", "via": "Figma MCP"},
      {"from": "theme", "to": "Shopify Store", "label": "Theme Push", "via": "Shopify CLI"},
      {"from": "Shopify Store", "to": "connector", "label": "Webhooks (orders/create, app/*)", "via": "HTTPS"},
      {"from": "connector", "to": "Shopify Store", "label": "Admin GraphQL API", "via": "shopify_app gem"},
      {"from": "connector", "to": "SAP", "label": "Order-Sync, Produkt-Sync", "via": "REST API"},
      {"from": "SAP", "to": "connector", "label": "Delta-Produkte (alle 15 Min)", "via": "Sidekiq Job"},
      {"from": "connector", "to": "Shopify Store", "label": "Checkout Extensions", "via": "App Proxy GraphQL"},
      {"from": "datalayer", "to": "GTM", "label": "Tracking Events (geplant)", "via": "dataLayer.push"}
    ],
    "extensions": [
      {"name": "credit-check", "type": "Checkout UI", "purpose": "Bonitaetspruefung an der Kasse"},
      {"name": "sepa-iban", "type": "Checkout UI", "purpose": "IBAN-Validierung fuer SEPA"},
      {"name": "payment-customization", "type": "Payment Function", "purpose": "Zahlarten ein-/ausblenden"},
      {"name": "order-credit-check-block", "type": "Admin Block", "purpose": "Bonitaet auf Bestellseite"},
      {"name": "order-sap-status-block", "type": "Admin Block", "purpose": "SAP-Status auf Bestellseite"}
    ]
  },
  "improvements": [
    {
      "title": "CORS in Connector einschraenken",
      "desc": "connector/config/initializers/cors.rb erlaubt aktuell origins '*' — in Produktion auf die tatsaechlichen Shopify-Domains einschraenken.",
      "priority": "high"
    },
    {
      "title": "Datalayer-Agent erstellen",
      "desc": "Wenn shopifyDatalayer befuellt wird, braucht es einen spezialisierten GTM/JS-Agenten.",
      "priority": "low"
    },
    {
      "title": "Extension-Validierung automatisieren",
      "desc": "Hook oder Validierungsschritt fuer Extension-TOML-Configs nach Aenderungen.",
      "priority": "low"
    },
    {
      "title": "Agent-Memory regelmaessig aufraumen",
      "desc": "Veraltete Eintraege in agent-memory/ identifizieren und entfernen — Memory wird sonst zu rauschig.",
      "priority": "medium"
    },
    {
      "title": "Backup-Strategie fuer Harness-Config",
      "desc": "Die .claude/-Konfiguration ist nirgends gesichert. Regelmaessiges Backup (z.B. rsync auf externes Laufwerk).",
      "priority": "medium"
    },
    {
      "title": "RSpec-Setup beim ersten Feature einrichten",
      "desc": "Gems (rspec-rails, factory_bot_rails, webmock, vcr, shoulda-matchers) installieren, spec_helper + rails_helper generieren. Beim ersten /connector-feature miterledigen.",
      "priority": "high"
    }
  ]
}
