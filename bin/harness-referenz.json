      "werkzeuge": ["learn_shopify_api", "search_docs_chunks", "validate", "validate_theme", "feedback"],
      "stichworte": ["Dev MCP", "shopify-dev-mcp"]
    }
  },
  "agent_rollen": ["planner", "implementer", "reviewer", "writer", "extractor"],
  "externe_agenten": [],
  "externe_skills": [
    "loop", "schedule", "simplify", "code-review", "security-review", "init", "run",
